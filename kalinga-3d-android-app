// --- INTERACTIVE 3D DRAGGABLE SHIELD EMBLEM ---
@Composable
fun Interactive3DShield(percentage: Int) {
    var rotX by remember { mutableFloatStateOf(0f) }
    var rotY by remember { mutableFloatStateOf(0f) }
    val animatedProgress by animateFloatAsState(targetValue = percentage / 100f, label = "scoreArc")

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Box(
            modifier = Modifier
                .size(110.dp)
                .pointerInput(Unit) {
                    detectDragGestures(
                        onDragEnd = {
                            rotX = 0f
                            rotY = 0f
                        }
                    ) { change, dragAmount ->
                        change.consume()
                        rotY = (rotY + dragAmount.x * 0.4f).coerceIn(-35f, 35f)
                        rotX = (rotX - dragAmount.y * 0.4f).coerceIn(-35f, 35f)
                    }
                }
                .graphicsLayer {
                    rotationX = rotX
                    rotationY = rotY
                    cameraDistance = 12f * density
                },
            contentAlignment = Alignment.Center
        ) {
            Canvas(modifier = Modifier.fillMaxSize()) {
                // Outer orbital ring
                drawArc(
                    color = CardBorder,
                    startAngle = -90f,
                    sweepAngle = 360f,
                    useCenter = false,
                    style = Stroke(width = 7.dp.toPx(), cap = StrokeCap.Round)
                )
                // Active readiness arc
                drawArc(
                    brush = Brush.sweepGradient(listOf(EmeraldAccent, EmergencyAmber, EmeraldAccent)),
                    startAngle = -90f,
                    sweepAngle = 360f * animatedProgress,
                    useCenter = false,
                    style = Stroke(width = 7.dp.toPx(), cap = StrokeCap.Round)
                )

                // 3D-styled layered shield body
                val w = size.width
                val h = size.height
                val shieldPath = Path().apply {
                    moveTo(w * 0.50f, h * 0.22f)
                    lineTo(w * 0.74f, h * 0.31f)
                    lineTo(w * 0.71f, h * 0.58f)
                    quadraticBezierTo(w * 0.65f, h * 0.72f, w * 0.50f, h * 0.79f)
                    quadraticBezierTo(w * 0.35f, h * 0.72f, w * 0.29f, h * 0.58f)
                    lineTo(w * 0.26f, h * 0.31f)
                    close()
                }
                drawPath(
                    path = shieldPath,
                    brush = Brush.linearGradient(
                        colors = listOf(Color(0xFF1E3A5F), Color(0xFF0F2942)),
                        start = Offset(0f, 0f),
                        end = Offset(w, h)
                    )
                )
                drawPath(
                    path = shieldPath,
                    color = EmeraldAccent,
                    style = Stroke(width = 2.dp.toPx())
                )

                // Inner gold/amber 4-point compass star emblem
                val starPath = Path().apply {
                    moveTo(w * 0.50f, h * 0.36f)
                    lineTo(w * 0.54f, h * 0.46f)
                    lineTo(w * 0.64f, h * 0.50f)
                    lineTo(w * 0.54f, h * 0.54f)
                    lineTo(w * 0.50f, h * 0.64f)
                    lineTo(w * 0.46f, h * 0.54f)
                    lineTo(w * 0.36f, h * 0.50f)
                    lineTo(w * 0.46f, h * 0.46f)
                    close()
                }
                drawPath(path = starPath, color = EmergencyAmber)
            }
        }
        Spacer(modifier = Modifier.height(4.dp))
        Text("Drag 3D Shield", fontSize = 10.sp, color = TextSecondary)
    }
}

