@Composable
fun KalingaApp() {
    val context = LocalContext.current
    var selectedTab by remember { mutableIntStateOf(0) }
    var selectedCity by remember { mutableStateOf("Quezon City") }
    var showCityDialog by remember { mutableStateOf(false) }
    var showScoreBreakdown by remember { mutableStateOf(false) }
    var showRemindersDialog by remember { mutableStateOf(false) }

    // 16 Emergency Checklist Items (Pre-checked 4/16 to match screenshot's 36% Ready)
    var checklist by remember {
        mutableStateOf(
            listOf(
                // Go-Bag Essentials (10 items)
                ChecklistItem(1, "Drinking Water (4L per person/day for 3 days)", "Go-Bag Essentials", isChecked = true),
                ChecklistItem(2, "Non-perishable ready-to-eat food (3-day supply)", "Go-Bag Essentials", isChecked = true),
                ChecklistItem(3, "LED Flashlight & extra batteries", "Go-Bag Essentials", isChecked = true),
                ChecklistItem(4, "First-Aid Kit & maintenance medications", "Go-Bag Essentials", isChecked = true),
                ChecklistItem(5, "Fully charged Power Bank & charging cables", "Go-Bag Essentials", isChecked = false),
                ChecklistItem(6, "Emergency Whistle & multi-tool", "Go-Bag Essentials", isChecked = false),
                ChecklistItem(7, "Extra clothes, rain poncho & thermal blanket", "Go-Bag Essentials", isChecked = false),
                ChecklistItem(8, "N95 face masks & hygiene/sanitation kit", "Go-Bag Essentials", isChecked = false),
                ChecklistItem(9, "Battery-powered or hand-crank AM/FM radio", "Go-Bag Essentials", isChecked = false),
                ChecklistItem(10, "Heavy-duty waterproof tactical backpack", "Go-Bag Essentials", isChecked = false),
                // Documents & Finance (2 items)
                ChecklistItem(11, "Waterproof folio with Valid IDs, birth certificates & titles", "Documents & Finance", isChecked = false),
                ChecklistItem(12, "Emergency cash in small bills & coins", "Documents & Finance", isChecked = false),
                // Family & Evacuation Plan (4 items)
                ChecklistItem(13, "Designated family meeting point outside home & barangay", "Family & Evacuation Plan", isChecked = false),
                ChecklistItem(14, "Printed emergency contact card inside every bag", "Family & Evacuation Plan", isChecked = false),
                ChecklistItem(15, "Utility shut-off plan (LPG tank, main breaker, water valve)", "Family & Evacuation Plan", isChecked = false),
                ChecklistItem(16, "Pet evacuation carrier & 3-day pet food supply", "Family & Evacuation Plan", isChecked = false)
            )
        )
    }

    var contacts by remember {
        mutableStateOf(
            listOf(
                EmergencyContact(1, "Philippine Emergency Hotline", "Barangay Official", "911", isPriority = true),
                EmergencyContact(2, "Philippine Red Cross", "Doctor / Medical", "143", isPriority = false),
                EmergencyContact(3, "NDRRMC Operations Center", "National Disaster Council", "0289115061", isPriority = false)
            )
        )
    }

    // Score Calculation: 15% base from contacts + up to 85% from 16 checklist items (4/16 = 36%)
    val checkedCount = checklist.count { it.isChecked }
    val readinessPercent = 15 + ((checkedCount.toFloat() / checklist.size) * 85).toInt()
    val milestonesCompleted = (checkedCount / 4).coerceIn(0, 4)

    MaterialTheme(
        colorScheme = darkColorScheme(
            background = BgNavyDark,
            surface = CardNavy,
            primary = EmeraldAccent,
            onPrimary = BgNavyDark,
            onBackground = TextPrimary,
            onSurface = TextPrimary
        )
    ) {
        Scaffold(
            containerColor = BgNavyDark,
            topBar = {
                KalingaTopBar(
                    city = selectedCity,
                    reminderCount = 3,
                    onCityClick = { showCityDialog = true },
                    onRemindersClick = { showRemindersDialog = true },
                    onEmergencyCall = { dialNumber(context, "911") }
                )
            },
            bottomBar = {
                NavigationBar(
                    containerColor = CardNavy,
                    contentColor = TextPrimary
                ) {
                    val navItems = listOf(
                        Triple("Home", Icons.Filled.Home, 0),
                        Triple("Ready Check", Icons.Filled.CheckCircle, 1),
                        Triple("Safe Spots", Icons.Filled.LocationOn, 2),
                        Triple("Safety Guide", Icons.Filled.MenuBook, 3),
                        Triple("Circle", Icons.Filled.People, 4)
                    )
                    navItems.forEach { (label, icon, index) ->
                        NavigationBarItem(
                            selected = selectedTab == index,
                            onClick = { selectedTab = index },
                            icon = { Icon(icon, contentDescription = label) },
                            label = { Text(label, fontSize = 10.sp, maxLines = 1) },
                            colors = NavigationBarItemDefaults.colors(
                                selectedIconColor = BgNavyDark,
                                indicatorColor = EmeraldAccent,
                                unselectedIconColor = TextSecondary,
                                selectedTextColor = EmeraldAccent,
                                unselectedTextColor = TextSecondary
                            )
                        )
                    }
                }
            }
        ) { innerPadding ->
            Box(
                modifier = Modifier
                    .padding(innerPadding)
                    .fillMaxSize()
            ) {
                when (selectedTab) {
                    0 -> HomeDashboardScreen(
                        city = selectedCity,
                        readinessPercent = readinessPercent,
                        milestonesCompleted = milestonesCompleted,
                        checklist = checklist,
                        contacts = contacts,
                        onNavigate = { selectedTab = it },
                        onOpenScoreBreakdown = { showScoreBreakdown = true },
                        onCallContact = { dialNumber(context, it) }
                    )
                    1 -> ReadyCheckScreen(
                        checklist = checklist,
                        onToggleItem = { id ->
                            checklist = checklist.map {
                                if (it.id == id) it.copy(isChecked = !it.isChecked) else it
                            }
                        }
                    )
                    2 -> SafeSpotsScreen(city = selectedCity)
                    3 -> SafetyGuideScreen()
                    4 -> CircleOfSafetyScreen(
                        contacts = contacts,
                        onCall = { dialNumber(context, it) },
                        onAddContact = { name, role, phone ->
                            contacts = contacts + EmergencyContact(contacts.size + 1, name, role, phone)
                        }
                    )
                }
            }

            if (showCityDialog) {
                CitySelectorDialog(
                    currentCity = selectedCity,
                    onSelect = {
                        selectedCity = it
                        showCityDialog = false
                    },
                    onDismiss = { showCityDialog = false }
                )
            }

            if (showScoreBreakdown) {
                ScoreBreakdownDialog(
                    readinessPercent = readinessPercent,
                    checkedCount = checkedCount,
                    totalCount = checklist.size,
                    contactCount = contacts.size,
                    onDismiss = { showScoreBreakdown = false }
                )
            }

            if (showRemindersDialog) {
                RemindersDialog(onDismiss = { showRemindersDialog = false })
            }
        }
    }
}

