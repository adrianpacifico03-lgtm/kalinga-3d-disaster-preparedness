// --- DATA MODELS ---
data class ChecklistItem(
    val id: Int,
    val title: String,
    val category: String,
    val isChecked: Boolean = false
)

data class EmergencyContact(
    val id: Int,
    val name: String,
    val role: String,
    val phone: String,
    val isPriority: Boolean = false
)

data class SafeSpot(
    val name: String,
    val type: String,
    val distance: String,
    val address: String
)

data class SafetyManual(
    val title: String,
    val agency: String,
    val steps: List<String>
)

